<mxfile host="app.diagrams.net" modified="2026-11-02T16:56:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="er-page" name="ER Diagram"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="er_title" value="JOB APPLICATION TRACKER — ER DIAGRAM" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="330" y="25" width="900" height="45" as="geometry" /></mxCell><mxCell id="users" value="&lt;b&gt;USERS&lt;/b&gt;&lt;hr&gt;PK user_id : UUID&lt;br&gt;name : VARCHAR&lt;br&gt;email : VARCHAR (UNIQUE)&lt;br&gt;password_hash : VARCHAR&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="160" width="290" height="225" as="geometry" /></mxCell><mxCell id="applications" value="&lt;b&gt;APPLICATIONS&lt;/b&gt;&lt;hr&gt;PK application_id : UUID&lt;br&gt;FK user_id : UUID&lt;br&gt;company_name : VARCHAR&lt;br&gt;job_title : VARCHAR&lt;br&gt;job_type : VARCHAR&lt;br&gt;location : VARCHAR&lt;br&gt;job_url : TEXT&lt;br&gt;applied_date : DATE&lt;br&gt;deadline : DATE&lt;br&gt;status : VARCHAR&lt;br&gt;salary : DECIMAL (optional)&lt;br&gt;notes : TEXT&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#EAF2F8;strokeColor=#4472C4;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="140" width="340" height="330" as="geometry" /></mxCell><mxCell id="interviews" value="&lt;b&gt;INTERVIEWS&lt;/b&gt;&lt;hr&gt;PK interview_id : UUID&lt;br&gt;FK application_id : UUID&lt;br&gt;interview_date : TIMESTAMP&lt;br&gt;interview_type : VARCHAR&lt;br&gt;meeting_link : TEXT&lt;br&gt;notes : TEXT&lt;br&gt;created_at : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#EAF2F8;strokeColor=#4472C4;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="300" height="255" as="geometry" /></mxCell><mxCell id="documents" value="&lt;b&gt;DOCUMENTS&lt;/b&gt;&lt;hr&gt;PK document_id : UUID&lt;br&gt;FK user_id : UUID&lt;br&gt;FK application_id : UUID (nullable)&lt;br&gt;file_name : VARCHAR&lt;br&gt;file_url : TEXT&lt;br&gt;document_type : VARCHAR&lt;br&gt;upload_date : TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#EAF2F8;strokeColor=#4472C4;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="470" y="610" width="340" height="230" as="geometry" /></mxCell><mxCell id="e1" value="1 user : many applications" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;strokeWidth=1.5;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="applications"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="1 application : many interviews" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;strokeWidth=1.5;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="applications" target="interviews"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="1 user : many documents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;strokeWidth=1.5;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="documents"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="0..1 application : many documents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERone;endFill=0;startArrow=ERmany;startFill=0;strokeWidth=1.5;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="applications" target="documents"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="er_note" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• Each application belongs to one student.&lt;br&gt;• An application can have multiple interview rounds.&lt;br&gt;• A document belongs to a user and may optionally be linked to an application.&lt;br&gt;• Store password_hash, never a plain-text password." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="900" y="610" width="420" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="architecture-page" name="Architecture Diagram"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="arch_title" value="JOB APPLICATION TRACKER — SYSTEM ARCHITECTURE" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1100" height="45" as="geometry" /></mxCell><mxCell id="client" value="&lt;b&gt;STUDENT / USER&lt;/b&gt;&lt;br&gt;Web browser" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="95" width="260" height="75" as="geometry" /></mxCell><mxCell id="frontend" value="&lt;b&gt;FRONTEND — React + Vite&lt;/b&gt;&lt;br&gt;Pages • Forms • Dashboard • Search &amp; Filters&lt;br&gt;Charts (Recharts) • Client-side validation" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="225" width="520" height="125" as="geometry" /></mxCell><mxCell id="backend" value="&lt;b&gt;BACKEND — Node.js + Express&lt;/b&gt;&lt;br&gt;REST API • Business logic • Input validation&lt;br&gt;Authentication middleware (JWT)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DDEBF7;strokeColor=#4472C4;strokeWidth=1.5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="520" height="125" as="geometry" /></mxCell><mxCell id="auth" value="&lt;b&gt;Authentication&lt;/b&gt;&lt;br&gt;Register / Login&lt;br&gt;JWT token validation" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="435" width="270" height="105" as="geometry" /></mxCell><mxCell id="appsvc" value="&lt;b&gt;Application API&lt;/b&gt;&lt;br&gt;CRUD applications&lt;br&gt;Status &amp; interview management" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390" y="610" width="280" height="105" as="geometry" /></mxCell><mxCell id="analytics" value="&lt;b&gt;Analytics API&lt;/b&gt;&lt;br&gt;Counts • Conversion rates&lt;br&gt;Monthly application summaries" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="610" width="280" height="105" as="geometry" /></mxCell><mxCell id="db" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Users • Applications&lt;br&gt;Interviews • Documents metadata" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FCE4D6;strokeColor=#C65911;strokeWidth=1.5;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1190" y="420" width="300" height="135" as="geometry" /></mxCell><mxCell id="storage" value="&lt;b&gt;Cloudinary / File Storage&lt;/b&gt;&lt;br&gt;CVs • Cover letters&lt;br&gt;Uploaded document files" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F4CCCC;strokeColor=#CC6666;strokeWidth=1.5;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1190" y="650" width="300" height="115" as="geometry" /></mxCell><mxCell id="extnote" value="&lt;b&gt;Optional later integrations&lt;/b&gt;&lt;br&gt;Email reminders • Calendar sync&lt;br&gt;AI resume analysis / job matching" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F2F2F2;strokeColor=#7F7F7F;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="300" height="105" as="geometry" /></mxCell><mxCell id="a1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a2" value="REST / JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="frontend" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a3" value="auth checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a4" value="routes &amp; logic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="appsvc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a5" value="aggregation queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="analytics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a6" value="SQL / ORM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a7" value="upload / retrieve files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="backend" target="storage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a8" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="appsvc" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a9" value="read aggregates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="analytics" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="a10" value="future extension" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#555555;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="extnote" target="backend"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="arch_security" value="&lt;b&gt;Security basics&lt;/b&gt;&lt;br&gt;Hash passwords • Validate inputs • Authorize by user_id&lt;br&gt;Use environment variables for secrets • Restrict file types and size" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="825" width="650" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>